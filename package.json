{
  "name": "hazzino-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node --env-file-if-exists=.env --watch backend/server.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "mongodb": "latest",
    "mongodb-memory-server": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
